# ── Uni+ environment variables ──────────────────────────────────────────────
# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# Demo mode (default: true). Runs the whole app with seeded profiles and
# localStorage — no network calls to Supabase. Set to "false" to use Supabase.
# Demo mode is also forced on automatically if the Supabase keys are missing.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps JavaScript API + Places API + Distance Matrix API.
# Restrict this key to your domains (see README). Optional: without it the map
# step falls back to the geographic midpoint of the schools.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: self-hosted Jitsi domain (default: meet.jit.si)
NEXT_PUBLIC_JITSI_DOMAIN=
